POSTGRES_DB=webhooklab
POSTGRES_USER=webhooklab
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+asyncpg://webhooklab:change-this-database-password@postgres:5432/webhooklab
REDIS_URL=redis://redis:6379/0
TOKEN_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:3000
BACKEND_INTERNAL_URL=http://api:8000
EVENT_RETENTION_HOURS=168
MAX_BODY_BYTES=262144
RATE_LIMIT_PER_MINUTE=120
BACKUP_PATH=./backups
